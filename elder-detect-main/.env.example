# ============================================================
#  elder_decete — 环境变量配置模板
# ============================================================
#  用法：
#      cp .env.example .env      # 然后填入真实值
#  · .env 已被 .gitignore 忽略，绝不提交真实密钥
#  · 本 .env.example 可提交，作为团队配置清单 / 部署文档
#
#  配置优先级（高 → 低）：
#      CLI 参数(--xxx)  >  本文件(.env)  >  scripts/build_config.py 默认值
#  即：本文件只做「覆盖」；留空则自动回退代码中的安全默认值。
# ============================================================


# ---------- 视觉语言模型 (VLM) 服务方 ----------
# 默认使用火山方舟 (ark)。切换 provider 时改 ARK_VLM_PROVIDER 并填对应密钥。

# ---- 火山方舟（默认，推荐）----
ARK_VLM_PROVIDER=ark
# 你的方舟 API Key（用 ark 时必填；缺失则脚本报 "未设置环境变量 ARK_API_KEY"）
ARK_API_KEY=
# 视觉模型 endpoint（留空回退 build_config 默认 ep-20260713153135-wlsmb）
ARK_VLM_MODEL=ep-20260713153135-wlsmb

# ---- 如需切换阿里云百炼 (dashscope)，取消注释并填值 ----
# ARK_VLM_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# ARK_VLM_MODEL=qwen-vl-max-latest

# ---- 如需切换 OpenAI，取消注释并填值 ----
# ARK_VLM_PROVIDER=openai
# OPENAI_API_KEY=

# ---- 如需切换 Google，取消注释并填值 ----
# GOOGLE_API_KEY=


# ============================================================
#  其余可调参数（超时 / 并发 / 权重阈值 等）
#  不在本文件中，集中在 scripts/build_config.py 配置，
#  同样遵循「代码默认 + 命令行 --xxx 覆盖」原则，无需写进 .env。
# ============================================================
